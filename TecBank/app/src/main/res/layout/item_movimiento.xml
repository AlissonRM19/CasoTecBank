<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A1A2E"
    android:padding="12dp"
    android:layout_margin="6dp"
    android:elevation="4dp">

    <TextView android:id="@+id/tvNumeroTarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1234-5678-9012-3456"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <TextView android:id="@+id/tvDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pago Recibos"
        android:textColor="#AAAAAA"/>

    <TextView android:id="@+id/tvTipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Retiro"
        android:textColor="#FFBB00"/>

    <TextView android:id="@+id/tvFecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="15/03/2025"
        android:textColor="#AAAAAA"/>

    <TextView android:id="@+id/tvTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="-₡50.000"
        android:textColor="#00FF00"
        android:textStyle="bold"/>

</LinearLayout>
